<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net6.0-windows;netcoreapp3.0;net472;net462;net461</TargetFrameworks>
	<LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>Tategaki</Title>
    <Description>WPF Vertical Text Control Library</Description>
    <Copyright>Copyright © 2014-2025 EH500_Kintarou</Copyright>
    <Company>EH500_Kintarou</Company>
    <Authors>EH500_Kintarou</Authors>
	<VersionPrefix>3.2.3</VersionPrefix>
	<VersionSuffix></VersionSuffix>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/EH500-Kintarou/Tategaki</RepositoryUrl>
	<PackageTags>WPF;Tategaki;縦書き;Vertical writing</PackageTags>
	<PackageProjectUrl>https://github.com/EH500-Kintarou/Tategaki</PackageProjectUrl>
	<PackageReleaseNotes>- ターゲットフレームワークに以下を追加
  - .NET Framework 4.6.1（現行サポートされている最低バージョン）
  - .NET Framework 4.6.2（GlyphRunのオーバーロードが変更になるバージョン）
  - .NET Core 3.0（.NET CoreでWindows Desktopがサポートされた最低バージョン）
  - .NET8.0（最新のLTSバージョン）
	</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.ValueTuple" Version="4.6.1" />
  </ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net461'">
		<PackageReference Include="System.Memory" Version="4.5.5" />
		<PackageReference Include="System.ValueTuple" Version="4.5.0" />
	</ItemGroup>
</Project>
